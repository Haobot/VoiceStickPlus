#pragma once

// 由 CMake 从 VOICESTICK_BUILTIN_* cache 变量填充（@ONLY 替换）。
// 本文件是模板，构建时生成到 ${CMAKE_CURRENT_BINARY_DIR}/builtin_secrets.h。

namespace voicestick {

// 编译期内置凭据。预配置 MSI 分发场景下作为新用户首启回退值，避免新用户被要求
// 填写 ASR/LLM 凭据。公开构建留空（Active* 回退空，正常读用户配置）。
// 运行时 Active*() 在配置字段为空时回退到对应内置值；不修改 config 字段，不落盘。
//
// 安全：凭据编译进二进制可被逆向提取，与 MSI 内明文 config.template.toml 同级别风险，
// 仅用于内测分发，勿用于公开发布。

// 火山引擎 ASR API Key（volcengine 模式）。
constexpr const char* kBuiltinAsrApiKey = "@VOICESTICK_BUILTIN_API_KEY@";

// 腾讯云 ASR 凭据（tencent 模式）。
constexpr const char* kBuiltinTencentSecretId = "@VOICESTICK_BUILTIN_TENCENT_SECRET_ID@";
constexpr const char* kBuiltinTencentSecretKey = "@VOICESTICK_BUILTIN_TENCENT_SECRET_KEY@";
constexpr const char* kBuiltinTencentAppid = "@VOICESTICK_BUILTIN_TENCENT_APPID@";

// DeepSeek LLM 凭据（OpenAI 兼容；翻译/精修/热词提炼复用）。
constexpr const char* kBuiltinLlmApiKey = "@VOICESTICK_BUILTIN_LLM_API_KEY@";
constexpr const char* kBuiltinLlmBaseUrl = "@VOICESTICK_BUILTIN_LLM_BASE_URL@";
constexpr const char* kBuiltinLlmModel = "@VOICESTICK_BUILTIN_LLM_MODEL@";

}  // namespace voicestick
